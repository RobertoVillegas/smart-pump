{
  "name": "smart-pump",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:api": "turbo build --filter=@smart-pump/api",
    "build:web": "turbo build --filter=web",
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@smart-pump/api",
    "dev:web": "turbo dev --filter=web",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "preview:web": "turbo preview --filter=web",
    "start:api": "turbo start --filter=@smart-pump/api",
    "test:api": "turbo test --filter=@smart-pump/api",
    "typecheck": "turbo typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test:e2e": "playwright test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "turbo": "^2.8.17",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "ultracite": "7.6.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.1"
}
